# ===== Base de datos (Vercel usa PostgreSQL) =====
# Crea una base gratis en https://supabase.com o https://neon.tech
DATABASE_URL="postgresql://usuario:password@host:5432/siped?schema=public"

# ===== Autenticación =====
# Genera con: npx auth secret
AUTH_SECRET="generar-con-npx-auth-secret"
# Google OAuth: https://console.cloud.google.com/
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ===== URL de la app =====
# En Vercel: https://siped.vercel.app (o tu dominio propio)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===== IA (elige una) =====
# https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# https://platform.deepseek.com/api_keys (alternativa)
DEEPSEEK_API_KEY=""

# ===== Google Drive (opcional) =====
# https://console.cloud.google.com/ -> OAuth client ID
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""

# ===== Stripe (opcional) =====
# https://dashboard.stripe.com/
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_WEEKLY=""
STRIPE_PRICE_MONTHLY=""
